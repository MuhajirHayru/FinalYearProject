# Password recovery email (SMTP)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=Green Path <no-reply@greenpath.et>

# Password recovery SMS (Africa's Talking). Keep API keys in deployment secrets.
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
AFRICASTALKING_TIMEOUT_SECONDS=10

# Public origin used in password reset links.
FRONTEND_BASE_URL=http://localhost:3000
